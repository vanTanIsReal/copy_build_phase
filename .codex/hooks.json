{
  "description": "Record Codex prompt and stop events in the shared project AI log.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "log-prompt",
            "type": "command",
            "command": "bash -lc 'repo=$(git rev-parse --show-toplevel) && bash \"$repo/scripts/_pyrun.sh\" \"$repo/scripts/log_hook.py\" --tool=codex'",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$repo = git rev-parse --show-toplevel; & (Join-Path $repo 'scripts/log_hook.ps1') -Tool codex\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "log-stop",
            "type": "command",
            "command": "bash -lc 'repo=$(git rev-parse --show-toplevel) && bash \"$repo/scripts/_pyrun.sh\" \"$repo/scripts/log_hook.py\" --tool=codex'",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$repo = git rev-parse --show-toplevel; & (Join-Path $repo 'scripts/log_hook.ps1') -Tool codex\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
