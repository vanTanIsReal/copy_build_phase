# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in the values you need.
# Never commit .env to git.

# ---- LLM Configuration ----
# LLM_PROVIDER selects which client get_llm() builds: "google" (default), "groq", or "openai".
LLM_PROVIDER=google
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
MODEL_NAME=gemini-2.5-flash
# Groq example: LLM_PROVIDER=groq, MODEL_NAME=openai/gpt-oss-20b (reliable tool-calling; get a key at https://console.groq.com/keys)
# OpenAI example: LLM_PROVIDER=openai, MODEL_NAME=gpt-4o-mini (get a key at https://platform.openai.com/api-keys)

# Evaluation-only RAGAS configuration via OpenRouter. Keep the real key in .env/Render secrets.
OPENROUTER_API_KEY=
RAGAS_APPLICATION_MODEL=openai/gpt-5.6-luna
RAGAS_EVALUATOR_MODEL=openai/gpt-5.6-luna
RAGAS_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Self-imposed daily token ceiling, purely for the usage warning on the Admin dashboard —
# not enforced by any provider, just an early-warning number you pick.
DAILY_TOKEN_BUDGET=200000

# ---- Organizations ----
ALLOW_SELF_SERVICE_ORGANIZATION_CREATION=false

# ---- Agent context & memory ----
# Optional layer budgets. Policy/system and output reserve are protected; these percentages apply
# only to the matching context layers and do not need to sum to 100%.
AGENT_CONTEXT_WINDOW_TOKENS=32768
AGENT_OUTPUT_RESERVE_TOKENS=4096
MEMORY_SHORT_TERM_FRACTION=0.10
MEMORY_LONG_TERM_FRACTION=0.04
MEMORY_EPISODIC_FRACTION=0.03
MEMORY_RETRIEVAL_FRACTION=0.03
MEMORY_HEARTBEAT_INTERVAL_SECONDS=900
MEMORY_COMPACTION_MESSAGE_THRESHOLD=24
MEMORY_RECENT_MESSAGES_TO_KEEP=12
MEMORY_CONVERSATION_SUMMARY_FRACTION=0.03

# Consent-scoped rolling summary for 1-1/group chat conversations (conversation_summary_service.py)
CONVERSATION_SUMMARY_ENABLED=true
CONVERSATION_SUMMARY_THRESHOLD_MESSAGES=30
CONVERSATION_SUMMARY_BATCH_SIZE=60
CONVERSATION_SUMMARY_MAX_CHARS=12000
CONVERSATION_SUMMARY_INTERVAL_SECONDS=900
CONVERSATION_SUMMARY_SWEEP_LIMIT=10

# ---- Database ----
# PostgreSQL is required for development and production. SQLite is reserved for unit tests.
DATABASE_URL=postgresql+asyncpg://orbit:orbit-local-password@localhost:5432/orbit
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

# ---- Auth ----
# Change this before production. Keep it secret.
SECRET_KEY=replace-with-at-least-32-random-bytes-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Secret required by the one-time first-admin setup at http://localhost:5174/register.
# Normal User registration and Google signup always create role=user.
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-value

# ---- Auth — Google Sign-In ----
# "Sign in with Google" (ID-token verification only, no client secret) - unrelated to the "Google
# Calendar" section below, which is a separate, per-user OAuth Client (each user connects their
# OWN Calendar, not a shared account). Create a Web application OAuth Client ID (distinct from the
# Calendar section's Client) at https://console.cloud.google.com/apis/credentials, Authorized
# JavaScript origins: http://localhost:5173 for local dev. Must match Frontend/user/.env.local's
# VITE_GOOGLE_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Development uses a restricted regex so localhost, private LAN, and Radmin VPN work on any port
# without hardcoding the current machine address. Production rejects this regex and requires
# exact trusted origins in CORS_ORIGINS.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2}|26(?:\.\d{1,3}){3})(?::\d{1,5})?$

# ---- Google Calendar ----
# Create a separate Web OAuth client. Refresh/access tokens are encrypted per user in PostgreSQL.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
FRONTEND_ORIGIN=http://localhost:5173
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh

# Fernet key encrypting each user's Calendar refresh_token at rest - generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER rotate once users have connected - every stored refresh_token becomes unreadable garbage
# and everyone has to reconnect. Empty = Calendar connect/use fails fast with a clear error
# instead of silently storing a plaintext secret.
CREDENTIAL_ENCRYPTION_KEY=

# Frontend origin - the OAuth callback page's postMessage back to the opener window is scoped to
# this origin only, so an unrelated page can't listen in on the "connected" signal.
FRONTEND_ORIGIN=http://localhost:5173
# How often (seconds) the backend polls Google Calendar for changes made outside the app (e.g.
# edited directly in Google Calendar) - real push notifications need a public HTTPS callback URL,
# which this project doesn't have without a real deployment, so this is the practical stand-in.
CALENDAR_POLL_INTERVAL_SECONDS=20

# ---- Request burst protection (single backend worker) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_CRUD=60/minute

# ---- Reminders / Scheduler ----
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Optional AI logging / tracing ----
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ai20k-agent
# LANGCHAIN_TRACING_V2=true

# ---- Instructor-provided AI hook logging ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ============================================
# Staging / E2E evaluation (not application runtime settings)
# ============================================
# These values are read by evaluation commands/harnesses, not by src/config.py.
# Backend/user/direct-admin URLs below returned HTTP 200 on 2026-08-28. The admin URL embedded in
# the user bundle is tracked separately because it redirects to an inaccessible Vercel deployment.
STAGING_BACKEND_URL=https://orbit-backend-xkgq.onrender.com
STAGING_API_BASE_URL=https://orbit-backend-xkgq.onrender.com/api/v1
STAGING_WS_URL=wss://orbit-backend-xkgq.onrender.com/api/v1/ws
STAGING_USER_URL=https://c3-app-132-auo2.vercel.app
STAGING_ADMIN_URL=https://admin-nu-six-83.vercel.app
STAGING_USER_LINKED_ADMIN_URL=https://admin-c3-app-132-auo2.vercel.app
# Public OAuth Client ID extracted from the deployed user bundle; this is not a client secret.
STAGING_GOOGLE_CLIENT_ID=877007149275-dkmvt9fnn6gqsdmasu0qc5djq37pseh8.apps.googleusercontent.com

# Revisions actually running when the staging evaluation was captured on 2026-08-28.
# Keep them separate until all three deployments are rebuilt from one release commit.
EXPECTED_BACKEND_DEPLOY_COMMIT=def0bf3dfb4664f395d7a74bac6f23e39793870b
EXPECTED_USER_DEPLOY_COMMIT=6c8b489f51e683ccd4218956989df1d5a696b43c
EXPECTED_ADMIN_DEPLOY_COMMIT=8195003923c1a8387faf0fa1b526b267d09f60d8

# Dedicated staging accounts only. Fill these in .env; never put real credentials in this example.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Second regular staging user for WebSocket delivery, memory isolation and concurrent-user tests.
E2E_SECOND_USER_EMAIL=
E2E_SECOND_USER_PASSWORD=
# Google test-account email is only an operator hint. Never store its password here; complete
# Google consent/2FA manually in the visible browser when requested.
E2E_GOOGLE_ACCOUNT_EMAIL=

# Safety switches. Change to true in .env only after authorizing creation/deletion of synthetic
# staging records and temporary Google Calendar events. The harness must clean up after itself.
E2E_ALLOW_TEST_DATA_WRITE=false
E2E_ALLOW_GOOGLE_EVENT_WRITE=false
E2E_CLEANUP_AFTER_RUN=true
E2E_TEST_DATA_PREFIX=orbit-eval-20260828
E2E_BROWSER=chromium
E2E_HEADLESS=true

# Real chat/model latency. Kept below RATE_LIMIT_CHAT=15/minute by default.
EVAL_CHAT_REQUESTS=10
EVAL_CHAT_CONCURRENCY=1
EVAL_CHAT_TIMEOUT_SECONDS=120

# Realtime/load ceiling for staging. Raise only with explicit infrastructure approval.
EVAL_LOAD_MAX_CONCURRENCY=5
EVAL_LOAD_TOTAL_REQUESTS=100
EVAL_LOAD_DURATION_SECONDS=60
EVAL_WS_CONNECTIONS=5
EVAL_REMINDER_WAIT_SECONDS=180

# Dedicated local PostgreSQL created for evaluation; never point this at production.
TEST_DATABASE_URL=postgresql+asyncpg://orbit_eval@127.0.0.1:55432/orbit_agent_eval_test

# Actual staging values verified through the Render API on 2026-08-28. Prices are USD per one
# million text tokens from the official OpenAI API model page.
EVAL_MODEL_PROVIDER=openai
EVAL_MODEL_NAME=gpt-4.1-mini
EVAL_MODEL_INPUT_PRICE_PER_1M_USD=0.40
EVAL_MODEL_OUTPUT_PRICE_PER_1M_USD=1.60

# Optional deployment access. Needed to prove deployed revisions and collect Render scheduler/
# queue logs. Keep tokens only in .env or the shell environment, never in this tracked file.
RENDER_API_KEY=
RENDER_BACKEND_SERVICE_ID=srv-d9qmq3bm8hqs738p5lg0
VERCEL_TOKEN=
# Optional. Only usable when the token owner has access to the protected deployment's project.
VERCEL_AUTOMATION_BYPASS_SECRET=
VERCEL_TEAM_ID=team_B3ccOSBU6mWYvIchagNElcIl
VERCEL_USER_PROJECT_ID=prj_HLfeDlrfCfmOmInsXgXcKWqvKJYo
VERCEL_ADMIN_PROJECT_ID=prj_6GKedTBsQPIFRZW4u8qBnFzOZrNc

# Browser quality gates used for accessibility, Lighthouse and Web Vitals evaluation.
EVAL_LIGHTHOUSE_PERFORMANCE_MIN=80
EVAL_LIGHTHOUSE_ACCESSIBILITY_MIN=90
EVAL_WEB_VITALS_LCP_MAX_MS=2500
EVAL_WEB_VITALS_INP_MAX_MS=200
EVAL_WEB_VITALS_CLS_MAX=0.1
