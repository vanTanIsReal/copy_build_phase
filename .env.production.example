# ============================================================================
# Orbit — biến môi trường PRODUCTION (template)
# ============================================================================
# KHÁC .env.example (dev) ở chỗ: mọi giá trị dưới đây phải là giá trị THẬT của môi trường
# production, không có localhost, không có secret dùng lại từ máy dev.
#
# File này CHỈ là template — không chứa giá trị thật, được commit vào git.
# Nhập từng biến vào Render Dashboard -> Environment, KHÔNG tạo file .env trên server.
# render.yaml đã khai sẵn các biến `sync: false` để Render hỏi giá trị khi apply Blueprint.
#
# Sinh secret (chạy 1 lần, lưu vào password manager của nhóm):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                  # SECRET_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"     # CREDENTIAL_ENCRYPTION_KEY
# ============================================================================

# ---- App ----
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- Database ----
# Postgres managed (Render Postgres / Supabase Session pooler / Neon). Bắt buộc, không có default.
# KHÔNG thêm ?sslmode=... hay ?ssl=... vào URL — src/db/session.py set SSL riêng cho từng driver
# (asyncpg dùng kwarg `ssl`, psycopg dùng `sslmode` kiểu libpq); một query-param chung sẽ phá 1 trong 2.
# Nếu dùng Supabase: chọn tab "Session pooler" (port 5432), KHÔNG "Transaction pooler" (6543) —
# pooler transaction phá server-side prepared statement mà asyncpg dùng mặc định.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---- Agent context & memory (optional; defaults shown) ----
AGENT_CONTEXT_WINDOW_TOKENS=32768
AGENT_OUTPUT_RESERVE_TOKENS=4096
MEMORY_SHORT_TERM_FRACTION=0.10
MEMORY_LONG_TERM_FRACTION=0.04
MEMORY_EPISODIC_FRACTION=0.03
MEMORY_RETRIEVAL_FRACTION=0.03
MEMORY_HEARTBEAT_INTERVAL_SECONDS=900
MEMORY_COMPACTION_MESSAGE_THRESHOLD=24
MEMORY_RECENT_MESSAGES_TO_KEEP=12

# ---- Auth ----
# SECRET_KEY: đổi giá trị = vô hiệu hoá toàn bộ JWT đang phát hành -> mọi user bị đăng xuất.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Email được cấp role admin tự động khi đăng ký lần đầu trên production (kể cả qua Google sign-in).
INITIAL_ADMIN_EMAIL=

# ---- CORS / origin ----
# src/main.py dùng cors_origins.split(",") KHÔNG .strip() -> tuyệt đối không có khoảng trắng
# sau dấu phẩy, và không có dấu "/" ở cuối mỗi origin.
CORS_ORIGINS=https://app.example.com
FRONTEND_ORIGIN=https://app.example.com

# ---- LLM ----
LLM_PROVIDER=google
MODEL_NAME=gemini-2.5-flash
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_TEMPERATURE=0.7
# Trần token/ngày. Chạm ngưỡng -> is_over_budget() chặn hẳn /chat và proactive detection.
# Đây là lớp chặn CHI PHÍ ($) — xem RATE_LIMIT_* bên dưới cho lớp chặn BURST/ABUSE (req/phút).
DAILY_TOKEN_BUDGET=200000

# ---- Rate limiting (slowapi, in-memory - 1 instance/1 worker, không cần Redis) ----
# Bổ sung cho DAILY_TOKEN_BUDGET ở trên, không thay thế: budget chặn theo $ tổng cả app/ngày,
# rate limit chặn burst/abuse theo user hoặc IP/phút. Xem src/api/rate_limit.py.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_CRUD=60/minute

# ---- Google Sign-In (OAuth Client #1: chỉ verify ID token, không có secret) ----
# Authorized JavaScript origins trong Google Cloud Console phải có đúng FRONTEND_ORIGIN ở trên.
# Phải trùng với VITE_GOOGLE_CLIENT_ID lúc build frontend.
GOOGLE_OAUTH_CLIENT_ID=

# ---- Google Calendar (OAuth Client #2: authorization-code exchange, CÓ secret) ----
# Redirect URI phải khớp EXACT (scheme/host/port/dấu "/" cuối) với Authorized redirect URIs
# đã khai trong Google Cloud Console, và trỏ tới domain BACKEND chứ không phải frontend.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api.example.com/api/v1/calendar/oauth/callback
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh
# Poll Google Calendar mỗi N giây. Trên production 1 instance, giá trị 20s là ~4300 lượt poll/ngày
# cho mỗi user đã kết nối — cân nhắc nâng lên 60 khi có nhiều user để tránh chạm quota Calendar API.
CALENDAR_POLL_INTERVAL_SECONDS=60

# ---- Mã hoá credential ----
# Fernet key mã hoá refresh_token Google Calendar tại rest.
# TUYỆT ĐỐI KHÔNG đổi sau khi đã có user kết nối Calendar — mọi refresh_token đã lưu thành rác,
# tất cả phải kết nối lại. Backup key này cùng chỗ với backup DB, mất key = mất dữ liệu.
CREDENTIAL_ENCRYPTION_KEY=

# ---- Scheduler ----
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Vector store ----
# Ephemeral trên container! Mất sau mỗi lần deploy nếu không gắn persistent disk. Xem DEPLOYMENT.md.
CHROMA_PERSIST_DIR=./data/chroma

# ---- Observability ----
# Chưa tích hợp Sentry/APM (cố ý — xem DEPLOYMENT.md mục "Cố tình KHÔNG làm"). Theo dõi lỗi bằng
# Render Logs. Hai biến LANGCHAIN_* dưới đây do SDK LangChain tự đọc từ env, không qua src/config.py.
# LangSmith: đặt false trên production nếu không muốn nội dung hội thoại người dùng rời hệ thống.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=orbit-production
